{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventoux.dev/schema/engine-2/plan.schema.json",
  "title": "Ventoux plan",
  "description": "A plan's file under `plans/`. A plan: its fields, where it starts, and its states. Shape only: keys, types, name patterns and the expression operators. Whether a field read is declared, a role registered, a plan reference known or a step reachable is checked by `ventoux check`, never by this schema. A model's output may be constrained by it (layer 15) and is still a draft: read by the parser, checked by `ventoux check`, reviewed in a pull request; the builder never runs on model output (brief, D58).",
  "$defs": {
    "ActivityState": {
      "additionalProperties": false,
      "description": "Call one activity from the catalog, then move on by what happened: `done` or an outcome.",
      "properties": {
        "activity": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@[1-9][0-9]*$",
          "title": "Activity",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Expression"
          },
          "default": {},
          "title": "Inputs",
          "type": "object"
        },
        "on": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/Transitions"
            }
          },
          "title": "On",
          "type": "object"
        }
      },
      "required": [
        "activity",
        "on"
      ],
      "title": "ActivityState",
      "type": "object"
    },
    "Add": {
      "additionalProperties": false,
      "description": "`{\"+\": [a, b, …]}`: the sum of the arguments.",
      "properties": {
        "+": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 2,
          "title": "+",
          "type": "array"
        }
      },
      "required": [
        "+"
      ],
      "title": "Add",
      "type": "object"
    },
    "And": {
      "additionalProperties": false,
      "description": "`{\"and\": [a, b, …]}`: every argument is true.",
      "properties": {
        "and": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 2,
          "title": "And",
          "type": "array"
        }
      },
      "required": [
        "and"
      ],
      "title": "And",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "description": "A person with one of `roles` approves or rejects running the activity state `of`: its own\nact, never read from an outcome's name (brief, D23).",
      "properties": {
        "of": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Of",
          "type": "string"
        },
        "roles": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]*[smhd]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "of",
        "roles"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalState": {
      "additionalProperties": false,
      "description": "Ask for an approval, then move on by the answer: `approve`, `reject`, or `timeout`.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/Approval"
        },
        "on": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/Transitions"
            }
          },
          "title": "On",
          "type": "object"
        }
      },
      "required": [
        "approval",
        "on"
      ],
      "title": "ApprovalState",
      "type": "object"
    },
    "BooleanType": {
      "additionalProperties": false,
      "description": "`true` or `false`.",
      "properties": {
        "type": {
          "const": "boolean",
          "default": "boolean",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "BooleanType",
      "type": "object"
    },
    "Cat": {
      "additionalProperties": false,
      "description": "`{\"cat\": [a, b, …]}`: the texts joined.",
      "properties": {
        "cat": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 1,
          "title": "Cat",
          "type": "array"
        }
      },
      "required": [
        "cat"
      ],
      "title": "Cat",
      "type": "object"
    },
    "Count": {
      "additionalProperties": false,
      "description": "`{\"count\": {\"over\": list, \"where\": condition}}`: how many elements match.",
      "properties": {
        "count": {
          "$ref": "#/$defs/CountOver"
        }
      },
      "required": [
        "count"
      ],
      "title": "Count",
      "type": "object"
    },
    "CountOver": {
      "additionalProperties": false,
      "description": "What `count` reads: a list field, and which of its elements to count.",
      "properties": {
        "over": {
          "$ref": "#/$defs/Var"
        },
        "where": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "over"
      ],
      "title": "CountOver",
      "type": "object"
    },
    "DateType": {
      "additionalProperties": false,
      "description": "A day on the calendar, with no time and no time zone (brief, D66).",
      "properties": {
        "type": {
          "const": "date",
          "default": "date",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "DateType",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        }
      },
      "required": [
        "date"
      ],
      "type": "object"
    },
    "Display": {
      "additionalProperties": false,
      "description": "What people read: presentation, outside the plan's behaviour (brief, D5).",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "Display",
      "type": "object"
    },
    "Div": {
      "additionalProperties": false,
      "description": "`{\"/\": [a, b]}`: a divided by b.",
      "properties": {
        "/": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "/",
          "type": "array"
        }
      },
      "required": [
        "/"
      ],
      "title": "Div",
      "type": "object"
    },
    "Eq": {
      "additionalProperties": false,
      "description": "`{\"==\": [a, b]}`: a equals b.",
      "properties": {
        "==": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "==",
          "type": "array"
        }
      },
      "required": [
        "=="
      ],
      "title": "Eq",
      "type": "object"
    },
    "Exists": {
      "additionalProperties": false,
      "description": "`{\"exists\": \"approved_amount\"}`: whether the field has a value.",
      "properties": {
        "exists": {
          "title": "Exists",
          "type": "string"
        }
      },
      "required": [
        "exists"
      ],
      "title": "Exists",
      "type": "object"
    },
    "Expression": {
      "anyOf": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Day"
        },
        {
          "$ref": "#/$defs/Var"
        },
        {
          "$ref": "#/$defs/Eq"
        },
        {
          "$ref": "#/$defs/Ne"
        },
        {
          "$ref": "#/$defs/Gt"
        },
        {
          "$ref": "#/$defs/Ge"
        },
        {
          "$ref": "#/$defs/Lt"
        },
        {
          "$ref": "#/$defs/Le"
        },
        {
          "$ref": "#/$defs/And"
        },
        {
          "$ref": "#/$defs/Or"
        },
        {
          "$ref": "#/$defs/Not"
        },
        {
          "$ref": "#/$defs/Add"
        },
        {
          "$ref": "#/$defs/Sub"
        },
        {
          "$ref": "#/$defs/Mul"
        },
        {
          "$ref": "#/$defs/Div"
        },
        {
          "$ref": "#/$defs/If"
        },
        {
          "$ref": "#/$defs/In"
        },
        {
          "$ref": "#/$defs/Cat"
        },
        {
          "$ref": "#/$defs/String"
        },
        {
          "$ref": "#/$defs/Exists"
        },
        {
          "$ref": "#/$defs/Item"
        },
        {
          "$ref": "#/$defs/Count"
        },
        {
          "$ref": "#/$defs/Sum"
        }
      ]
    },
    "FieldType": {
      "discriminator": {
        "mapping": {
          "boolean": "#/$defs/BooleanType",
          "date": "#/$defs/DateType",
          "list": "#/$defs/ListType",
          "number": "#/$defs/NumberType",
          "outcome": "#/$defs/OutcomeType",
          "reference": "#/$defs/ReferenceType",
          "string": "#/$defs/StringType"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NumberType"
        },
        {
          "$ref": "#/$defs/StringType"
        },
        {
          "$ref": "#/$defs/BooleanType"
        },
        {
          "$ref": "#/$defs/OutcomeType"
        },
        {
          "$ref": "#/$defs/ReferenceType"
        },
        {
          "$ref": "#/$defs/DateType"
        },
        {
          "$ref": "#/$defs/ListType"
        }
      ]
    },
    "FinalState": {
      "additionalProperties": false,
      "description": "The plan has ended, and how.",
      "properties": {
        "final": {
          "title": "Final",
          "type": "string"
        }
      },
      "required": [
        "final"
      ],
      "title": "FinalState",
      "type": "object"
    },
    "Ge": {
      "additionalProperties": false,
      "description": "`{\">=\": [a, b]}`: a is greater than or equal to b.",
      "properties": {
        ">=": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": ">=",
          "type": "array"
        }
      },
      "required": [
        ">="
      ],
      "title": "Ge",
      "type": "object"
    },
    "Gt": {
      "additionalProperties": false,
      "description": "`{\">\": [a, b]}`: a is greater than b.",
      "properties": {
        ">": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": ">",
          "type": "array"
        }
      },
      "required": [
        ">"
      ],
      "title": "Gt",
      "type": "object"
    },
    "If": {
      "additionalProperties": false,
      "description": "`{\"if\": [condition, then, else]}`.",
      "properties": {
        "if": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "If",
          "type": "array"
        }
      },
      "required": [
        "if"
      ],
      "title": "If",
      "type": "object"
    },
    "In": {
      "additionalProperties": false,
      "description": "`{\"in\": [a, [x, y, …]]}`: a is one of the listed values.",
      "properties": {
        "in": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "items": {
                "$ref": "#/$defs/Value"
              },
              "type": "array"
            }
          ],
          "title": "In",
          "type": "array"
        }
      },
      "required": [
        "in"
      ],
      "title": "In",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "description": "`{\"item\": \"amount\"}`: a field of the current element, inside `count` and `sum`.",
      "properties": {
        "item": {
          "title": "Item",
          "type": "string"
        }
      },
      "required": [
        "item"
      ],
      "title": "Item",
      "type": "object"
    },
    "Le": {
      "additionalProperties": false,
      "description": "`{\"<=\": [a, b]}`: a is less than or equal to b.",
      "properties": {
        "<=": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "<=",
          "type": "array"
        }
      },
      "required": [
        "<="
      ],
      "title": "Le",
      "type": "object"
    },
    "ListType": {
      "additionalProperties": false,
      "description": "A list of records, each with the declared fields; read with `count`, `sum` and `item`.",
      "properties": {
        "type": {
          "const": "list",
          "default": "list",
          "title": "Type",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldType"
          },
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "fields",
        "type"
      ],
      "title": "ListType",
      "type": "object"
    },
    "Lt": {
      "additionalProperties": false,
      "description": "`{\"<\": [a, b]}`: a is less than b.",
      "properties": {
        "<": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "<",
          "type": "array"
        }
      },
      "required": [
        "<"
      ],
      "title": "Lt",
      "type": "object"
    },
    "Mul": {
      "additionalProperties": false,
      "description": "`{\"*\": [a, b, …]}`: the product of the arguments.",
      "properties": {
        "*": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 2,
          "title": "*",
          "type": "array"
        }
      },
      "required": [
        "*"
      ],
      "title": "Mul",
      "type": "object"
    },
    "Ne": {
      "additionalProperties": false,
      "description": "`{\"!=\": [a, b]}`: a differs from b.",
      "properties": {
        "!=": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "!=",
          "type": "array"
        }
      },
      "required": [
        "!="
      ],
      "title": "Ne",
      "type": "object"
    },
    "Not": {
      "additionalProperties": false,
      "description": "`{\"!\": [a]}`: a is false.",
      "properties": {
        "!": {
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "!",
          "type": "array"
        }
      },
      "required": [
        "!"
      ],
      "title": "Not",
      "type": "object"
    },
    "Number": {
      "type": "number"
    },
    "NumberType": {
      "additionalProperties": false,
      "description": "A number: one type, exact decimal (brief, D20).",
      "properties": {
        "type": {
          "const": "number",
          "default": "number",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "NumberType",
      "type": "object"
    },
    "Or": {
      "additionalProperties": false,
      "description": "`{\"or\": [a, b, …]}`: at least one argument is true.",
      "properties": {
        "or": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 2,
          "title": "Or",
          "type": "array"
        }
      },
      "required": [
        "or"
      ],
      "title": "Or",
      "type": "object"
    },
    "OutcomeType": {
      "additionalProperties": false,
      "description": "A task's answer: a closed list of names (brief, D9).",
      "properties": {
        "type": {
          "const": "outcome",
          "default": "outcome",
          "title": "Type",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "outcomes",
        "type"
      ],
      "title": "OutcomeType",
      "type": "object"
    },
    "ReferenceType": {
      "additionalProperties": false,
      "description": "The ID of a record kept in another system, typed by that system's name (brief, D16).",
      "properties": {
        "type": {
          "const": "reference",
          "default": "reference",
          "title": "Type",
          "type": "string"
        },
        "system": {
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "system",
        "type"
      ],
      "title": "ReferenceType",
      "type": "object"
    },
    "State": {
      "oneOf": [
        {
          "$ref": "#/$defs/ActivityState"
        },
        {
          "$ref": "#/$defs/WaitState"
        },
        {
          "$ref": "#/$defs/ApprovalState"
        },
        {
          "$ref": "#/$defs/FinalState"
        }
      ]
    },
    "String": {
      "additionalProperties": false,
      "description": "`{\"string\": [a]}`: a number, boolean or reference as text.",
      "properties": {
        "string": {
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "String",
          "type": "array"
        }
      },
      "required": [
        "string"
      ],
      "title": "String",
      "type": "object"
    },
    "StringType": {
      "additionalProperties": false,
      "description": "A text.",
      "properties": {
        "type": {
          "const": "string",
          "default": "string",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "StringType",
      "type": "object"
    },
    "Sub": {
      "additionalProperties": false,
      "description": "`{\"-\": [a, b]}`: a minus b.",
      "properties": {
        "-": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "$ref": "#/$defs/Expression"
            }
          ],
          "title": "-",
          "type": "array"
        }
      },
      "required": [
        "-"
      ],
      "title": "Sub",
      "type": "object"
    },
    "Sum": {
      "additionalProperties": false,
      "description": "`{\"sum\": {\"over\": list, \"where\": condition, \"value\": number}}`: their total.",
      "properties": {
        "sum": {
          "$ref": "#/$defs/SumOver"
        }
      },
      "required": [
        "sum"
      ],
      "title": "Sum",
      "type": "object"
    },
    "SumOver": {
      "additionalProperties": false,
      "description": "What `sum` reads: a list field, which of its elements, and the number each one adds.",
      "properties": {
        "over": {
          "$ref": "#/$defs/Var"
        },
        "where": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "over",
        "value"
      ],
      "title": "SumOver",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "description": "Where to go next, if `when` holds (or always, with no `when`).",
      "properties": {
        "target": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "target"
      ],
      "title": "Transition",
      "type": "object"
    },
    "Transitions": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "type": "array"
        }
      ]
    },
    "Value": {
      "anyOf": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Day"
        }
      ]
    },
    "Var": {
      "additionalProperties": false,
      "description": "A declared field of the case file: `{\"var\": \"approved_amount\"}`.",
      "properties": {
        "var": {
          "title": "Var",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "title": "Var",
      "type": "object"
    },
    "Wait": {
      "additionalProperties": false,
